# Firebase Master (configuração web pública; não contém chave privada)
NEXT_PUBLIC_MASTER_FIREBASE={"apiKey":"SUA_API_KEY","authDomain":"SEU_PROJETO.firebaseapp.com","projectId":"SEU_PROJECT_ID","appId":"SEU_APP_ID"}

# Segredos exclusivos do servidor — preencher apenas no .env.local/Vercel, nunca aqui
MASTER_FIREBASE_SERVICE_ACCOUNT=
TENANT_SECRETS_KEY=

# Emuladores: habilitar somente no desenvolvimento local
NEXT_PUBLIC_USE_EMULATORS=false
